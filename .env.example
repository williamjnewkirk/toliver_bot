# Copy to .env and fill in. Never commit the real .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Price source: "gametime" (JSON API, reliable, all-in prices) or
# "seatgeek" (Playwright scrape — blocked by DataDome without a valid session)
SOURCE=gametime
GAMETIME_EVENT_ID=69822806346f6babfa6ae7d3
# "total" = all-in incl. fees (what you actually pay); "prefee" = sticker price
GAMETIME_PRICE_FIELD=total

EVENT_URL=https://seatgeek.com/don-toliver-tickets/denver-colorado-ball-arena-2026-07-05-7-30-pm/concert/18050514#listing=BALImRRgX59
EVENT_DATE=2026-07-05
EVENT_NAME=Don Toliver — Octane Tour @ Ball Arena, Denver
FLOOR_KEYWORDS=floor,pit,ga,general admission
THRESHOLD_HIGH=250
THRESHOLD_LOW=200
# 5 min is fine for the gametime API; use 20+ for the seatgeek source
POLL_INTERVAL_MINUTES=5
POLL_JITTER_MINUTES=1

# Send a Telegram status message with the current price when the bot starts
SEND_STARTUP_MESSAGE=true

# Telegram-notify "bot is blocked" after this many failed polls in a row
FAILURES_BEFORE_NOTIFY=3

# Browser settings. "chrome" uses your installed Google Chrome (recommended —
# DataDome blocks the bundled Chromium far more aggressively). Set HEADLESS=false
# to watch the browser. PROFILE_DIR holds the persistent session cookies.
BROWSER_CHANNEL=chrome
HEADLESS=true
PROFILE_DIR=.browser_profile
